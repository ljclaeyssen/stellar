{
  "name": "stellar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "coverage": "pnpm -r --no-bail exec vitest run --coverage --passWithNoTests",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm format:check && pnpm -r run test",
    "check:p0": "pnpm check",
    "check:p1": "pnpm check",
    "check:p2": "pnpm check",
    "check:p3": "pnpm check",
    "check:p4": "pnpm check",
    "check:p5": "pnpm check",
    "check:p6": "pnpm check",
    "check:p7": "pnpm check",
    "check:p8": "pnpm check",
    "check:p9": "pnpm check",
    "setup:ui": "pnpm --filter @stellar/setup run build && node apps/setup/dist/main.js",
    "bench": "node scripts/bench.mjs",
    "secrets:encrypt": "sops -e -i",
    "secrets:decrypt": "sops -d"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
