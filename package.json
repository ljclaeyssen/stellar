{
  "name": "stellar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "coverage": "pnpm -r --no-bail exec vitest run --coverage --passWithNoTests",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm format:check && pnpm -r run test",
    "check:p0": "pnpm check",
    "check:p1": "pnpm check",
    "check:p2": "pnpm check",
    "check:p3": "pnpm check",
    "check:p4": "pnpm check",
    "check:p5": "pnpm check",
    "check:p6": "pnpm check",
    "check:p7": "pnpm check",
    "check:p8": "pnpm check",
    "secrets:encrypt": "sops -e -i",
    "secrets:decrypt": "sops -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
