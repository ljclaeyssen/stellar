{
  "name": "stellar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && pnpm -r run test",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm format:check && pnpm -r run test",
    "check:p0": "pnpm check",
    "check:p1": "pnpm check",
    "secrets:encrypt": "sops -e -i",
    "secrets:decrypt": "sops -d"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.6.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
