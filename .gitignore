# deps / build
node_modules/
dist/
coverage/
*.tsbuildinfo

# env
.env
.env.*

# secrets
# filets de sécurité (toute profondeur) — placés AVANT l'allowlist : en gitignore
# la dernière règle qui matche gagne, donc les `!config/*.enc.*` ci-dessous doivent
# rester en dernier pour qu'un secret *chiffré* (ex. config/midea-tokens.enc.json)
# ne soit pas ré-ignoré par `**/*token*.json`.
**/*-cert.json
**/*token*.json
*.key
*.pem
# tout config/ est exclu sauf l'explicitement chiffré/public
config/*
!config/.gitkeep
!config/*.enc.yaml
!config/*.enc.json
!config/regulation.yaml

# runtime
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
vitest-report.json
