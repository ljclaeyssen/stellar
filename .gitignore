# deps / build
node_modules/
dist/
coverage/
*.tsbuildinfo

# env
.env
.env.*

# secrets
# filets de sécurité (toute profondeur) — placés AVANT l'allowlist : en gitignore
# la dernière règle qui matche gagne, donc les `!config/*.enc.*` ci-dessous doivent
# rester en dernier pour qu'un secret *chiffré* (ex. config/midea-tokens.enc.json)
# ne soit pas ré-ignoré par `**/*token*.json`.
**/*-cert.json
**/*token*.json
*.key
*.pem
# tout config/ est exclu sauf l'explicitement chiffré/public
config/*
!config/.gitkeep
!config/*.enc.yaml
!config/*.enc.json
!config/regulation.yaml
# table de mapping Zigbee2MQTT : publique par nature (friendly_name → entityId/kind/room),
# aucun secret — et versionnée, puisque c'est le chemin d'extensibilité de la spec §13.
!config/z2m-mapping.json

# runtime
*.log
# Données produites par les services quand ils tournent depuis la racine du dépôt
# (WorkingDirectory=/opt/stellar) : journal SQLite du core, budget quotidien de
# l'agent. Les .gitignore locaux d'apps/core et apps/agent couvrent le cas où un
# service tourne depuis son propre dossier.
data/

# IDE / OS
.idea/
.vscode/
.DS_Store
vitest-report.json
