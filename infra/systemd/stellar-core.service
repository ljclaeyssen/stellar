[Unit]
Description=Stellar core — miroir d'état, régulation, MCP
Documentation=file:/opt/stellar/docs/SPEC.md
After=network-online.target
Wants=network-online.target
# Pas de rate-limit de redémarrage : le service doit toujours finir par revenir.
# (StartLimitIntervalSec vit dans [Unit] depuis systemd 229.)
StartLimitIntervalSec=0

[Service]
Type=simple
User=stellar
WorkingDirectory=/opt/stellar
# STELLAR_MQTT_URL=… (peut contenir des credentials → fichier root:stellar 0640)
EnvironmentFile=/etc/stellar/stellar-core.env
ExecStart=/usr/bin/node /opt/stellar/apps/core/dist/main.js
# spec §14 : restart=always.
Restart=always
RestartSec=5
# Logs JSON sur stdout → journald (spec §14).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stellar-core

[Install]
WantedBy=multi-user.target
