# ══════════════════════════════════════════════════════════════════════════════
# Stellar — variables d'environnement (modèle)
#
# Copie : `cp .env.example .env` puis remplis — ou mieux : lance `claude` à la
# racine et tape `/setup` : l'assistant te guide valeur par valeur.
#
# ⚠️ `.env` est gitignoré. Les SECRETS (clés, tokens, certificats) ne vont ni
# dans git ni en clair dans un fichier synchronisé : ils vivent en sops
# (`config/*.enc.*`) ou dans l'environnement du service (systemd EnvironmentFile
# sur le N100). Ce fichier liste tout, service par service — chaque service ne
# lit que sa section.
# ══════════════════════════════════════════════════════════════════════════════

# ── Commun ────────────────────────────────────────────────────────────────────
# URL du broker mosquitto. Dev : loopback. N100 : mqtt://<ip-du-n100>:1883
STELLAR_MQTT_URL=mqtt://localhost:1883
# Interface d'écoute du broker publié par docker compose (infra/).
# Dev : 127.0.0.1 (défaut). N100 : 0.0.0.0 (LAN uniquement, jamais d'ouverture WAN).
STELLAR_MQTT_BIND=127.0.0.1

# ── apps/core (miroir, journal, régulation, API, MCP, pont HA) ────────────────
CORE_DB_PATH=apps/core/data/journal.db
CORE_API_PORT=8850
CORE_MCP_PORT=8851
CORE_REGULATION_FILE=config/regulation.yaml
# Pont HA-discovery : activer en P8 quand Home Assistant tourne (1 = actif).
CORE_HA_BRIDGE=

# ── apps/drivers/androidtv (P1) ───────────────────────────────────────────────
# IP FIXE de la TV (bail DHCP statique) — veille réseau activée sur la TV.
ATV_HOST=
ATV_ENTITY_ID=tv_salon
ATV_ROOM=salon
# Produit par `stellar-androidtv pair` (code affiché à l'écran). SECRET → sops.
ATV_CERT_FILE=config/androidtv-cert.json

# ── apps/drivers/hue (P2) ─────────────────────────────────────────────────────
# https://<ip-fixe-du-bridge> (cert autosigné accepté pour le bridge uniquement)
HUE_BRIDGE_URL=
# Clé obtenue par `stellar-hue pair` (bouton du bridge). SECRET → sops.
# Soit la clé en clair dans l'env du service, soit un fichier :
HUE_APP_KEY=
HUE_APP_KEY_FILE=config/hue-app-key.json

# ── apps/drivers/netatmo (P3) ─────────────────────────────────────────────────
# App OAuth créée sur https://dev.netatmo.com (voir TODO_LJ.md §P3). SECRETS.
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
# Fichier {"refreshToken":"..."} amorcé par le Token generator du portail.
# Le driver le fait tourner ensuite tout seul (rotation atomique). SECRET → sops.
NETATMO_TOKEN_FILE=config/netatmo-token.json
# Cadences de polling (ms) — défauts raisonnables, ne pas descendre (rate limits).
NETATMO_THERMOSTAT_INTERVAL_MS=90000
NETATMO_STATION_INTERVAL_MS=300000

# ── apps/drivers/midea (P4) ───────────────────────────────────────────────────
# Fichier [{entityId, room, host, id, token, key}] issu de l'atelier P4.0
# (TODO_LJ.md — URGENT, la fenêtre cloud se referme). SECRET → sops.
MIDEA_UNITS_FILE=config/midea-units.json
# Polling doux : le dongle SK103 décroche si sollicité fort. 30–60 s.
MIDEA_POLL_MS=45000

# ── apps/drivers/tempo (P6) ───────────────────────────────────────────────────
# Optionnel : compte RTE (data.rte-france.com, API « Tempo Like Supply Contract »).
# Sans compte, le driver bascule tout seul sur l'opendata public — ça marche.
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=
TEMPO_POLL_MS=3600000

# ── apps/drivers/z2m-normalizer (P5) ──────────────────────────────────────────
Z2M_BASE_TOPIC=zigbee2mqtt
Z2M_MAPPING_FILE=config/z2m-mapping.json

# ── apps/agent (P7) ───────────────────────────────────────────────────────────
# SECRET → environnement du service uniquement (systemd EnvironmentFile / sops).
ANTHROPIC_API_KEY=
AGENT_PORT=8852
AGENT_CORE_MCP_URL=http://127.0.0.1:8851/mcp
# Fournisseur de cours de bourse : `fake` tant qu'aucun vrai n'est choisi.
MARKET_PROVIDER=fake
AGENT_TURN_TIMEOUT_MS=120000
